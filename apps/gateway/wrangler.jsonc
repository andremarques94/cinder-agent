{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cinder-agent-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  "vars": {
    "SANDBOX_DOMAIN": "example.com",
    "OPENCODE_INSTANCE": "standard-1",
    "INACTIVITY_TIMEOUT_MINUTES": "30",
    "GITHUB_APP_ID": "",
    "ACCESS_AUD": "",
  },
  "secrets": {
    "required": ["ADMIN_TOKEN", "GITHUB_APP_PRIVATE_KEY"],
  },

  "routes": [{ "pattern": "*.example.com/*", "zone_name": "example.com" }],
  "workers_dev": true,

  "containers": [
    {
      "class_name": "OpencodeSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "opencode": { "dockerfile": "../../sandbox/Dockerfile", "build_context": "../../sandbox" },
      },
    },
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "cinder-agent", "migrations_dir": "src/users/migrations" },
  ],
  "access": {
    "dev": { "aud": "local-dev", "identity": { "email": "me@example.com" } },
  },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "cinder-agent-backups" }],
  "durable_objects": {
    "bindings": [{ "name": "OPENCODE_SANDBOX", "class_name": "OpencodeSandbox" }],
  },
  "exports": {
    "OpencodeSandbox": { "type": "durable-object", "storage": "sqlite" },
  },
}
