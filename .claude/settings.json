{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(vp check *)",
      "Bash(vp run ready)",
      "Bash(vp test *)",
      "Bash(vp run -r test)",
      "Bash(vp exec knip)",
      "Bash(node_modules/.bin/vp check *)",
      "Bash(node_modules/.bin/vp run ready)",
      "Bash(gitleaks git *)",
      "Bash(scripts/smoke.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": ["Read(**/.dev.vars)", "Read(**/*.secrets.env)", "Read(**/*.pem)"]
  }
}
