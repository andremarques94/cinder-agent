{
  "name": "cinder-agent",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "ready": "vp check && vp exec knip && vp run -r test",
    "dev": "vp run gateway#dev",
    "deploy": "vp run gateway#deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "knip": "catalog:",
    "vite-plus": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
